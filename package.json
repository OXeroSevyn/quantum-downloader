{
  "name": "quantum-downloader",
  "version": "1.2.0",
  "description": "Fast multi-connection download manager for files, video pages, streams and torrents",
  "main": "dist-electron/main.js",
  "author": "Subham Dey",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "build:mac": "node scripts/build-mac.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "test": "npm run build:electron && node tests/engine-tests.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "webtorrent": "^3.0.21",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.quantum.downloader",
    "productName": "Quantum Downloader",
    "directories": {
      "output": "dist-package"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Quantum Downloader",
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "yt-dlp.exe"
        ]
      },
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    }
  }
}
